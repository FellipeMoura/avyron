* text=auto eol=lf

# Godot text formats — keep them diffable
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.json text eol=lf

# ---------------------------------------------------------------------------
# Git LFS
#
# Modelo de criatura sai entre 8 e 27 MB. Commitado direto, o blob fica no
# histórico PARA SEMPRE — reescrever depois exige `filter-repo` e invalida todo
# clone existente. Por isso o LFS entra antes do primeiro asset, não depois.
#
# Todo binário de arte passa por aqui, inclusive PNG pequeno. Dividir por
# tamanho criaria a pergunta "esse aqui é LFS?" em cada commit, e a resposta
# errada é irreversível.
#
# Clonando pela primeira vez: `git lfs install` uma vez por máquina, e o
# checkout já traz os arquivos reais em vez dos ponteiros.
# ---------------------------------------------------------------------------

# Malhas e cenas 3D
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.obj   filter=lfs diff=lfs merge=lfs -text

# Texturas
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.tga  filter=lfs diff=lfs merge=lfs -text
*.exr  filter=lfs diff=lfs merge=lfs -text
*.hdr  filter=lfs diff=lfs merge=lfs -text

# Áudio
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text

# Fontes ficam fora do LFS de propósito: são pequenas, mudam quase nunca, e
# manter o clone raso funcionando sem `git lfs` instalado tem valor.
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
