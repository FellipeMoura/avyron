config_version=5

[application]

config/name="Avyron"
config/description="Jogo 3D de coleção de criaturas com tema paleontológico. Câmera isométrica ortográfica travada em 30°/45°, exploração em tempo real, combate por turnos."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Bestiary="*res://scripts/data/bestiary_data.gd"
Progress="*res://scripts/world/player_progress.gd"

