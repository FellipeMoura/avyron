; Engine configuration file.
; Best edited through the Godot editor — hand edits here are only for the
; few settings that are decisions rather than preferences.

config_version=5

[application]

config/name="Avyron"
config/description="Jogo 3D de coleção de criaturas com tema paleontológico. Câmera isométrica ortográfica travada em 30°/45°, exploração em tempo real, combate por turnos."
config/features=PackedStringArray("4.7", "Forward Plus")

[rendering]

; Forward+ is required by the lighting and shader pipeline described in the
; `direcao-3d-arte` design document (baked lighting, single toon shader,
; blob shadow decals). Do not switch to Mobile or Compatibility.
renderer/rendering_method="forward_plus"
